    $(FILEFORMAT_DIR)/elf/HostedElfExecutableWriter.cpp \
    $(FILEFORMAT_DIR)/macho/MachOHostedReader.cpp \
    $(FILEFORMAT_DIR)/macho/MachOExecutableWriter.cpp \
    $(LINKER_DIR)/MacOSLinker.cpp \
