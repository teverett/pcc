    $(FILEFORMAT_DIR)/coff/CoffFormat.cpp \
    $(FILEFORMAT_DIR)/elf/ElfFormat.cpp \
    $(FILEFORMAT_DIR)/macho/MachOFormat.cpp \
    $(FILEFORMAT_DIR)/aout/AoutFormat.cpp \
