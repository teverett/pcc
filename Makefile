# Makefile for pdp-c-compiler (pcc): a C-subset compiler with a
# pluggable codegen backend per target (see src/codegen/Codegen.h) - today
# pdp7 and 8086, each emitting that target's own assembly and (via
# that target's own real assembler) a real binary. Builds against the
# ANTLR4 C++ runtime, pure make - no CMake.
#
# The generated C++ lexer/parser code itself - src/generated/, from
# grammar/*.g4 - is checked into git, not generated by this Makefile:
# ANTLR (the Java tool + jar) is a contributor-machine-only dependency
# now, needed only when a .g4 file actually changes (run
# scripts/generate-grammars.sh by hand, review the diff under
# src/generated/, commit both together), not a build or CI one. This
# Makefile only ever compiles src/generated/ - it never invokes ANTLR
# itself.
#
# Local dev (macOS / Homebrew):
#   brew install antlr4-cpp-runtime
#   make
#
# Anywhere else (no Homebrew), point ANTLR4_RUNTIME_PREFIX at a C++
# runtime whose version matches whatever ANTLR version generated
# src/generated/ (currently 4.13.2) - generated code from one ANTLR
# version doesn't reliably compile against another version's runtime
# (e.g. 4.13.2's generated code needs antlr4::internal::OnceFlag,
# which doesn't exist before 4.11), so this isn't just "any C++
# runtime will do". See .github/workflows/ci.yml for two exact-
# version prebuilt sources that work: conda-forge's
# `antlr-cpp-runtime` package (Linux) and MSYS2's
# `mingw-w64-x86_64-antlr4-runtime-cpp` (Windows) - both happen to
# ship 4.13.2 prebuilt:
#   make ANTLR4_RUNTIME_PREFIX=/path/to/matching-runtime-install

ANTLR4_RUNTIME_PREFIX  ?= $(shell brew --prefix antlr4-cpp-runtime 2>/dev/null || echo /usr/local)

GEN_DIR      := src/generated
OBJ_DIR      := build/obj
BIN_DIR      := build/bin
SRC_DIR      := src

TARGET       := $(BIN_DIR)/pcc

CXX          ?= c++
CXXFLAGS     ?= -std=c++17 -O2 -Wall -Wextra -pthread
CPPFLAGS     := -I$(ANTLR4_RUNTIME_PREFIX)/include/antlr4-runtime \
                -I$(GEN_DIR) -I$(SRC_DIR)
LDFLAGS      := -L$(ANTLR4_RUNTIME_PREFIX)/lib
LDLIBS       := -lantlr4-runtime

GENERATED_SRCS := \
    $(GEN_DIR)/CLexer.cpp \
    $(GEN_DIR)/CParser.cpp \
    $(GEN_DIR)/CParserBaseVisitor.cpp \
    $(GEN_DIR)/CParserVisitor.cpp \
    $(GEN_DIR)/PccAsmLexer.cpp \
    $(GEN_DIR)/PccAsmParser.cpp \
    $(GEN_DIR)/PccAsmBaseVisitor.cpp \
    $(GEN_DIR)/PccAsmVisitor.cpp \
    $(GEN_DIR)/PccIRLexer.cpp \
    $(GEN_DIR)/PccIRParser.cpp \
    $(GEN_DIR)/PccIRParserBaseVisitor.cpp \
    $(GEN_DIR)/PccIRParserVisitor.cpp

SPACE :=
SPACE +=

# Each backend lives in its own subdirectory under src/codegen/ -
# see Codegen.h. Adding a new backend means adding its .cpp here and
# to BACKEND_DIRS below (for vpath), plus wiring it into main.cpp's
# makeBackend(). src/ast/, src/ir/, src/fileformat/ and
# src/preprocessor/ hold code shared across backends (AST.h/
# BuildAst.*; IR.h/IRBuilder.*/IRPrinter.*; FileFormat.h/the per-
# format Reader/Writer pairs under src/fileformat/<name>/ every
# backend's own assembler and every TargetLinker share;
# Preprocessor.* - the `#include`/`#define`/`#if` etc. pass that runs
# on every source file before ANTLR ever sees it) - not backend-
# specific, but still their own subdirectories needing the same vpath
# treatment.
BACKEND_DIRS := $(SRC_DIR)/codegen/pdp7 $(SRC_DIR)/codegen/x86_8086 $(SRC_DIR)/codegen/m6502 $(SRC_DIR)/codegen/m65c02 $(SRC_DIR)/codegen/m68k $(SRC_DIR)/codegen/mc68328 $(SRC_DIR)/codegen/pdp11 $(SRC_DIR)/codegen/i8080 $(SRC_DIR)/codegen/pic16 $(SRC_DIR)/codegen/pic18 $(SRC_DIR)/codegen/z80 $(SRC_DIR)/codegen/i8008 $(SRC_DIR)/codegen/stm8 $(SRC_DIR)/codegen/m16c $(SRC_DIR)/codegen/mips $(SRC_DIR)/codegen/mcs51 $(SRC_DIR)/codegen/stm32 $(SRC_DIR)/codegen/i386 $(SRC_DIR)/codegen/armm $(SRC_DIR)/codegen/arm $(SRC_DIR)/codegen/arm64 $(SRC_DIR)/codegen/powerpc $(SRC_DIR)/codegen/sparc
AST_DIR      := $(SRC_DIR)/ast
IR_DIR       := $(SRC_DIR)/ir
LINKER_DIR   := $(SRC_DIR)/linker
FACTORY_DIR  := $(LINKER_DIR)/factory
PREPROCESSOR_DIR := $(SRC_DIR)/preprocessor
# One subdirectory per optimizer pass (see Optimizer.h's own header
# comment), the same "one subdirectory per backend" shape BACKEND_DIRS
# below uses - Optimizer.h itself (the shared interface) stays directly
# under OPTIMIZERS_DIR, same as Codegen.h does for BACKEND_DIRS.
OPTIMIZERS_DIR    := $(SRC_DIR)/optimizers
OPTIMIZERS_DIRS   := $(OPTIMIZERS_DIR)/constant_folding $(OPTIMIZERS_DIR)/constant_propagation $(OPTIMIZERS_DIR)/algebraic_simplification $(OPTIMIZERS_DIR)/local_cse $(OPTIMIZERS_DIR)/dead_store_elimination $(OPTIMIZERS_DIR)/dead_code_elimination $(OPTIMIZERS_DIR)/unused_global_elimination $(OPTIMIZERS_DIR)/identical_code_folding
# Every file format this project reads/writes lives under one
# subdirectory each here - see src/fileformat/FileFormat.h's own
# header comment - instead of being split across src/coff/, src/elf/,
# src/objectformat/ and src/linker/format/ the way it used to be.
FILEFORMAT_DIR  := $(SRC_DIR)/fileformat
FILEFORMAT_DIRS := $(FILEFORMAT_DIR) $(FILEFORMAT_DIR)/archive $(FILEFORMAT_DIR)/coff $(FILEFORMAT_DIR)/elf $(FILEFORMAT_DIR)/macho $(FILEFORMAT_DIR)/aout $(FILEFORMAT_DIR)/flat $(FILEFORMAT_DIR)/raw $(FILEFORMAT_DIR)/rim $(FILEFORMAT_DIR)/ptr $(FILEFORMAT_DIR)/a7out $(FILEFORMAT_DIR)/list

HAND_SRCS := \
    $(SRC_DIR)/main.cpp \
