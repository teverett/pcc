ALL_SRCS := $(GENERATED_SRCS) $(HAND_SRCS)
OBJS     := $(patsubst %,$(OBJ_DIR)/%.o,$(notdir $(ALL_SRCS)))

vpath %.cpp $(GEN_DIR):$(SRC_DIR):$(AST_DIR):$(IR_DIR):$(LINKER_DIR):$(FACTORY_DIR):$(PREPROCESSOR_DIR):$(subst $(SPACE),:,$(OPTIMIZERS_DIRS)):$(subst $(SPACE),:,$(BACKEND_DIRS)):$(subst $(SPACE),:,$(FILEFORMAT_DIRS))

.PHONY: all clean generate build rt test test-hosted-internal

all: build rt

build: $(TARGET)

# Target runtime libraries (src/rt/<target>/, e.g. apple2/apple2.lib - see
# src/rt/Makefile) - each one's own Makefile invokes $(TARGET) itself, so
# this depends on it being built first.
rt: $(TARGET)
	$(MAKE) -C src/rt

# Only needed by hand, after editing a grammar/*.g4 file - see this
# Makefile's own header comment and scripts/generate-grammars.sh's.
# Not a prerequisite of build/all/test: src/generated/ is checked
# into git and already present.
generate:
	./scripts/generate-grammars.sh

# --- Compilation ------------------------------------------------------

$(OBJ_DIR)/%.cpp.o: %.cpp
	@mkdir -p $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -MMD -MP -c $< -o $@

$(TARGET): $(OBJS)
	@mkdir -p $(BIN_DIR)
	$(CXX) $(CXXFLAGS) $(OBJS) $(LDFLAGS) $(LDLIBS) -o $@

# Header dependencies: without this, editing a backend's .h alone
# (which main.cpp also includes) wouldn't trigger a rebuild of
# main.cpp.o by mtime rules, silently linking it - built against the
# old class layout - against a Backend .cpp.o built against the new one.
-include $(OBJS:.o=.d)

# --- Housekeeping -------------------------------------------------

clean:
	rm -rf build
	$(MAKE) -C src/rt clean

# Runs the shared preprocessor unit tests and every backend's test suite in
# turn - see tests/run_tests.sh's
# --target. A backend whose own target tool isn't installed (pdp7's
# simulator, 8086/68000's qemu, 6502/65c02's py65) fails loudly rather than
# being skipped silently; install it or run `tests/run_tests.sh
# $(TARGET) --target=<one>` directly to check just one. --target=8088
# isn't run here too - see src/main.cpp's own makeBackend() comment
# for why that would just be re-running the --target=8086 suite
# against provably byte-identical output.
$(BIN_DIR)/preprocessor_test: tests/preprocessor_test.cpp $(PREPROCESSOR_DIR)/Preprocessor.cpp $(PREPROCESSOR_DIR)/Preprocessor.h
	@mkdir -p $(BIN_DIR)
	$(CXX) $(CXXFLAGS) -I$(SRC_DIR) tests/preprocessor_test.cpp $(PREPROCESSOR_DIR)/Preprocessor.cpp -o $@

$(BIN_DIR)/archive_reader_test: tests/archive_reader_test.cpp $(FILEFORMAT_DIR)/archive/ArchiveReader.cpp $(FILEFORMAT_DIR)/archive/ArchiveReader.h
	@mkdir -p $(BIN_DIR)
	$(CXX) $(CXXFLAGS) -I$(SRC_DIR) tests/archive_reader_test.cpp $(FILEFORMAT_DIR)/archive/ArchiveReader.cpp -o $@

$(BIN_DIR)/macho_data_test: tests/macho_data_test.cpp $(SRC_DIR)/fileformat/macho/MachOFormat.cpp $(SRC_DIR)/fileformat/macho/MachOFormat.h $(SRC_DIR)/fileformat/ObjectFile.h
